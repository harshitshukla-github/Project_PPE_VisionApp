{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ppbmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to confirm your identity before starting a compliance check."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to use the camera to capture a PPE compliance photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to select a PPE compliance image for testing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow the app to use Face ID to confirm your identity."
        }
      ],
      "expo-status-bar"
    ]
  }
}
