# Copy this to mobile/.env (gitignored, matches the project's root .env
# convention) before running the app.

# REQUIRED as of Expo SDK 57: Expo's default global `fetch` ("Winter"
# runtime) does not support React Native's classic multipart file-upload
# shape ({ uri, name, type }), used by expo-camera / expo-image-picker for
# the photo captured in Capture -> POST /compliance/check. Without this
# flag, taking a photo fails with "Unsupported FormDataPart implementation".
# See node_modules/expo/src/winter/fetch/convertFormData.ts and
# node_modules/expo/src/winter/runtime.native.ts.
EXPO_PUBLIC_USE_RN_FETCH=1
