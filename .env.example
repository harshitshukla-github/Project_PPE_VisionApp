# ============================================================================
# PPB Vision Module — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# Roboflow — dataset download (get from app.roboflow.com/settings/api)
ROBOFLOW_API_KEY=rf_xxxxxxxxxxxxxxxx

# Kaggle — dataset download (get from kaggle.com/settings → API → Create New Token)
# Current scheme (recommended): Create New Token gives a single KGAT_... bearer
# token. The username is introspected from it, so the two legacy vars below are
# not needed alongside it.
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy scheme — only if you still have an old kaggle.json.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Kaggle PPE dataset identifier (format: owner/dataset-name from kaggle.com/datasets/...)
# Must label helmets AND vests on the SAME images, or it won't fix the
# co-occurrence gap that weakens safety_vest / no_vest.
KAGGLE_PPE_DATASET=owner/dataset-name

# Google Gemini 2.5 Flash — hybrid explainer
GOOGLE_API_KEY=AIzaXxxxxxxxxxxxxxxxxxx

# Model Configuration
PPB_MODEL_NAME=yolo11l                   # options: yolo26n, yolo26s, yolo26m, yolo26l, yolo26x, yolo11n, yolo11s, yolo11m, yolo11l, yolo11x
                                         # yolo11l is the benchmark-chosen GPU backend (runs/benchmark_report.md).
                                         # NOTE: `cli.py serve --model X` sets PPB_SERVE_MODEL and OVERRIDES this.
                                         # This is the fallback for `uvicorn src.api.main:app` and the default
                                         # for PPEDetector(), `cli.py probe`, and `cli.py info`.
PPB_CONFIDENCE_THRESHOLD=0.45            # minimum detection confidence (0.0 - 1.0)
PPB_IOU_THRESHOLD=0.50                   # NMS IoU threshold (YOLO11 only, YOLO26 is NMS-free)
PPB_DEVICE=0                             # GPU index (0, 1, ...) or "cpu"
PPB_IMG_SIZE=640                         # inference image size

# Gemini second opinion — when the detector cannot find a required item,
# Gemini looks at the photo and decides worn / not worn / uncertain.
# Accuracy over cost: one vision call and roughly 3-8 s per unsure check.
# NOTE: this sends the worker's photo to Google. Set to false to disable;
# unsure checks then stay NEEDS_REVIEW.
PPB_GEMINI_VERIFY=true
PPB_GEMINI_VERIFY_MIN_CONFIDENCE=0.75   # below this, a finding counts as uncertain
PPB_GEMINI_TIMEOUT_S=20

# PostgreSQL — admin system. Leave these empty: `uv run python cli.py db setup`
# creates the ppb_app role and the ppb / ppb_test databases, then fills both
# lines in with a generated password. TEST_DATABASE_URL may be wiped by tests.
DATABASE_URL=
TEST_DATABASE_URL=
# Seconds a server keeps the job matrix before re-reading it from the database.
PPB_MATRIX_CACHE_S=30

# Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR

# ── Debug: capture raw uploads ────────────────────────────────────────────────
# Writes the exact bytes the API receives to PPB_DEBUG_DUMP_DIR before decoding,
# and logs the decoded dimensions. Use it to see what the mobile app actually
# sends, then replay the file through `cli.py probe`.
# Stores worker photos (personal data) on disk — turn OFF when done.
PPB_DEBUG_DUMP_UPLOADS=false
PPB_DEBUG_DUMP_DIR=runs/uploads
